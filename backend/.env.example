PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=true
JWT_SECRET=replace-with-a-long-random-secret
# Generate with: openssl rand -base64 32
CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key
# Comma-separated exact frontend origins; example: https://your-site.example
CORS_ORIGINS=